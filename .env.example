# Production web/API address
NODE_ENV=production
HOST=0.0.0.0
PORT=4175
CORS_ORIGINS=https://plan.example.com

# Use randomly generated secrets; do not reuse either value.
ORBITPLAN_TOKEN_SECRET=replace-with-a-long-random-secret
CALENDAR_ENCRYPTION_KEY=replace-with-a-different-long-random-secret

# PostgreSQL (Docker Compose uses POSTGRES_PASSWORD to build its internal URL)
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgres://orbitplan:password@localhost:5432/orbitplan
DATABASE_SSL=true

# OAuth callback, then official provider credentials
OAUTH_REDIRECT_BASE=https://plan.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
