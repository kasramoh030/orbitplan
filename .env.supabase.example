# OrbitPlan on Supabase PostgreSQL — copy to .env.supabase and fill every placeholder.
# This project uses its own Node account/session API. Do NOT expose DATABASE_URL or Supabase service keys to the PWA/Android client.
NODE_ENV=production
HOST=0.0.0.0
PORT=4175

# Supabase session pooler for the eu-west-1 OrbitPlan project.
# Set DATABASE_PASSWORD in the Supabase dashboard / reset it before deployment.
DATABASE_URL=postgresql://postgres.duzlpceowvcyfnjkkqtm:<DATABASE_PASSWORD>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true

# Generate distinct random values for production; never commit actual values.
ORBITPLAN_TOKEN_SECRET=<GENERATE_A_LONG_RANDOM_SECRET>
CALENDAR_ENCRYPTION_KEY=<GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET>

# Replace with the public HTTPS origin used by the PWA and API.
CORS_ORIGINS=https://plan.example.com
OAUTH_REDIRECT_BASE=https://plan.example.com

# Leave empty until official OAuth apps and HTTPS redirect URIs are configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
